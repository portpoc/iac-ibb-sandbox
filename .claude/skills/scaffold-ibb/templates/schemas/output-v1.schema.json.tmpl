{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "{{CAPABILITY_NAME}}-output-v1",
  "title": "{{CAPABILITY_TITLE}} IBB - standardized output contract",
  "type": "object",
  "required": ["requestId", "executionId", "status", "buildingBlock"],
  "properties": {
    "requestId": { "type": "string" },
    "executionId": { "type": "string" },
    "status": {
      "description": "Shared status vocabulary across every IBB (05-standards-contracts.md §10). 'partially completed' exists deliberately: an interface that cannot distinguish it from failure produces orphaned resources nobody owns.",
      "enum": [
        "accepted",
        "validating",
        "waiting",
        "executing",
        "verifying",
        "completed",
        "rejected",
        "failed",
        "partially completed",
        "cancelled"
      ]
    },
    "buildingBlock": {
      "type": "object",
      "required": ["name", "version", "implementation"],
      "properties": {
        "name": { "const": "{{CAPABILITY_NAME}}" },
        "version": { "type": "string" },
        "implementation": { "type": "string" }
      }
    },
    "result": {
      "type": "object",
      "description": "Present when status is completed or partially completed. resourceId and operationalState are the baseline every capability returns; the rest come from the capability-specific proposal agreed per scaffold-ibb SKILL.md §1b.",
      "properties": {
        "resourceId": { "type": "string" },
        "operationalState": { "type": "string" },
{{RESULT_FIELDS_PROPERTIES}}
      }
    },
    "evidence": {
      "type": "object",
      "description": "Never contains secrets (SEC-006).",
      "properties": {
        "deploymentRecord": { "type": "string" },
        "complianceResult": { "enum": ["passed", "failed", "not-applicable"] },
        "evidenceLocation": { "type": "string" }
      }
    },
    "error": { "$ref": "ibb-error-v1.schema.json" }
  }
}
