# Copy to a .env at the workspace root and fill in. Never commit the real file.
# Port → Organization → Credentials.

PORT_CLIENT_ID=
PORT_CLIENT_SECRET=

# Region. Default is EU, which serves app.port.io and app.getport.io.
# US accounts (app.us.port.io) must set this to https://api.us.port.io
# PORT_API_BASE_URL=https://api.port.io
