{
  "identifier": "decommission_subnet",
  "title": "Decommission Subnet",
  "icon": "Cloud",
  "description": "Delete an existing Subnet resource via the subnet IBB pipeline (subnet@0.1.0).",
  "trigger": {
    "type": "self-service",
    "operation": "DELETE",
    "userInputs": {
      "properties": {
        "environment": {
          "type": "string",
          "title": "Environment",
          "enum": ["dev", "qua", "tst", "ppr", "prd"],
          "enumColors": {
            "dev": "blue",
            "qua": "yellow",
            "tst": "bronze",
            "ppr": "orange",
            "prd": "red"
          }
        },
        "platform": {
          "type": "string",
          "title": "Platform",
          "enum": ["aws", "azure"]
        },
        "applicationId": {
          "type": "string",
          "title": "Application ID",
          "description": "Pattern APP-nnn, e.g. APP-1234."
        },
        "costCenter": {
          "type": "string",
          "title": "Cost center"
        },
        "dataClassification": {
          "type": "string",
          "title": "Data classification",
          "enum": ["internal", "confidential"]
        },
        "changeReference": {
          "type": "string",
          "title": "Change reference",
          "description": "Approved change record reference. Required by the pipeline for environment: prd (SBP AWS-006/AZR-006); optional otherwise."
        },
        "cidrBlock": {
          "type": "string",
          "title": "CIDR block",
          "description": "The subnet's currently allocated CIDR block, for identification."
        },
        "networkExposure": {
          "type": "string",
          "title": "Network exposure",
          "enum": ["private", "public"]
        },
        "availabilityZoneIndex": {
          "type": "number",
          "title": "Availability zone index",
          "minimum": 0,
          "default": 0
        },
        "networkAclProfile": {
          "type": "string",
          "title": "Network ACL profile",
          "enum": ["default", "restrictive"]
        },
        "parentNetworkId": {
          "type": "string",
          "title": "Parent network ID",
          "description": "The VPC id (aws) or VNet name (azure) this subnet is created within."
        }
      },
      "required": [
        "environment",
        "platform",
        "applicationId",
        "costCenter",
        "dataClassification",
        "cidrBlock",
        "networkExposure",
        "availabilityZoneIndex",
        "networkAclProfile",
        "parentNetworkId"
      ],
      "order": [
        "environment",
        "platform",
        "applicationId",
        "costCenter",
        "dataClassification",
        "changeReference",
        "parentNetworkId",
        "cidrBlock",
        "networkExposure",
        "availabilityZoneIndex",
        "networkAclProfile"
      ]
    }
  },
  "invocationMethod": {
    "type": "GITHUB",
    "org": "portpoc",
    "repo": "iac-ibb-sandbox",
    "workflow": "subnet.yml",
    "workflowInputs": {
      "request": "{\"request\":{\"operation\":\"delete\",\"requestId\":\"req-{{ .run.id }}\"},\"buildingBlock\":{\"name\":\"subnet\",\"version\":\"0.1.0\"},\"context\":{\"applicationId\":\"{{ .inputs.applicationId }}\",\"environment\":\"{{ .inputs.environment }}\",\"platform\":\"{{ .inputs.platform }}\",\"costCenter\":\"{{ .inputs.costCenter }}\",\"dataClassification\":\"{{ .inputs.dataClassification }}\",\"requesterIdentity\":\"{{ .trigger.by.user.email }}\",\"correlationId\":\"corr-{{ .run.id }}\",\"changeReference\":\"{{ .inputs.changeReference }}\"},\"requirements\":{\"sizing\":{\"cidrBlock\":\"{{ .inputs.cidrBlock }}\"},\"access\":{\"networkExposure\":\"{{ .inputs.networkExposure }}\"},\"resilience\":{\"availabilityZoneIndex\":{{ .inputs.availabilityZoneIndex }} },\"security\":{\"networkAclProfile\":\"{{ .inputs.networkAclProfile }}\"},\"operations\":{\"parentNetworkId\":\"{{ .inputs.parentNetworkId }}\"} } }"
    },
    "reportWorkflowStatus": true
  },
  "requiredApproval": false
}
